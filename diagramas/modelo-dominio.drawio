ay as="points"><mxPoint x="1058.8" y="922.5" /></Array></mxGeometry></mxCell><mxCell id="e_genera_m0" value="1" parent="e_genera" vertex="1" connectable="0" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#111111;labelBackgroundColor=none;"><mxGeometry x="-0.88" relative="1" as="geometry"><mxPoint x="8" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="e_genera_m1" value="0..*" parent="e_genera" vertex="1" connectable="0" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontSize=12;fontColor=#111111;labelBackgroundColor=none;"><mxGeometry x="0.88" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e_incluye" value="incluye" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#1F4E79;strokeWidth=1.4;fontSize=12;fontColor=#111111;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.609;exitDx=0;exitDy=0;entryX=0;entryY=0.587;entryDx=0;entryDy=0;" parent="1" source="Evento" target="Cancion" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_incluye_m0" value="0..*" parent="e_incluye" vertex="1" connectable="0" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontSize=12;fontColor=#111111;labelBackgroundColor=none;"><mxGeometry x="-0.88" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e_incluye_m1" value="0..*" parent="e_incluye" vertex="1" connectable="0" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontSize=12;fontColor=#111111;labelBackgroundColor=none;"><mxGeometry x="0.88" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="titulo" value="Modelo de dominio – KarismaSync" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry as="geometry" x="375.0" y="10.0" width="537.5" height="35.0" /></mxCell><mxCell id="subtitulo" value="&lt;font color=&quot;#2E7D32&quot;&gt;En verde: cambios por evento masivo y Representante de músicos (Evaluación 2)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry as="geometry" x="375.0" y="42.5" width="537.5" height="20.0" /></mxCell><mxCell id="restricciones" value="&lt;b&gt;Restricciones&lt;/b&gt;&lt;br&gt;• Cada Convocatoria es de un solo integrante y tiene una Asistencia, que nace Pendiente (EST-02).&lt;br&gt;• motivo es obligatorio solo si estado = No asiste (máx. 200).&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• Cada Integrante tiene exactamente un rol (RolIntegrante).&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• lidera solo vale para integrantes con rol Líder de Alabanza y representa solo para el integrante con rol Representante de músicos: un líder no puede ser representante y un representante no puede ser líder.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• Toda banda tiene exactamente un Representante de músicos.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• RevisionDeEvento existe solo si tipo = Masivo; justificacion es obligatoria si decision = Rechazada (máx. 200).&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• Revisa el representante de la banda que organiza el evento.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;• Un evento Masivo nace Pendiente de aprobación; un Ensayo nace Vigente.&lt;/b&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#111111;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry as="geometry" x="1200.0" y="700.0" width="312.5" height="327.5" /></mxCell></root></mxGraphModel></diagram></mxfile>
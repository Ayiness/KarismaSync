<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs_Alabanza" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.0">
  <bpmn:collaboration id="Collaboration_AsIs_Alabanza">
    <bpmn:participant id="Participant_Alabanza" name="Coordinación de Ensayo de Alabanza (AS-IS)" processRef="Process_AsIs_Alabanza" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs_Alabanza" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Alabanza">
      <bpmn:lane id="Lane_Lider" name="LÍDER DE ALABANZA">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Quorum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Integrantes" name="INTEGRANTES DE LA BANDA">
        <bpmn:flowNodeRef>Task_Respond</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Necesidad de coordinar ensayo">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Propose" name="Proponer ensayo por WhatsApp (o en reunión dominical)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Respond" name="Responder confirmando su asistencia o inasistencia">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Quorum" name="¿Se llega al quórum de integrantes?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Propose" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Propose" targetRef="Task_Respond" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Respond" targetRef="Gateway_Quorum" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Sí" sourceRef="Gateway_Quorum" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Quorum" targetRef="Task_Cancel" />
    <bpmn:sequenceFlow id="Flow_End1" sourceRef="Task_Confirm" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_End2" sourceRef="Task_Cancel" targetRef="EndEvent_Fail" />
    <bpmn:endEvent id="EndEvent_Fail" name="(fin) Ensayo no realizado">
      <bpmn:incoming>Flow_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Success" name="(fin) Ensayo realizado">
      <bpmn:incoming>Flow_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Confirm" name="Confirmar y realizar el ensayo planteado">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_End1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cancel" name="Cancelar ensayo o volver a preguntar">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_End2</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_AsIs_Alabanza">
      <bpmndi:BPMNShape id="Participant_Alabanza_di" bpmnElement="Participant_Alabanza" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="850" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Integrantes_di" bpmnElement="Lane_Integrantes" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="820" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lider_di" bpmnElement="Lane_Lider" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="820" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="242" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Propose_di" bpmnElement="Task_Propose">
        <dc:Bounds x="320" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Respond_di" bpmnElement="Task_Respond">
        <dc:Bounds x="460" y="350" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Quorum_di" bpmnElement="Gateway_Quorum" isMarkerVisible="true">
        <dc:Bounds x="605" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="533.5" y="170" width="61" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Fail_di" bpmnElement="EndEvent_Fail">
        <dc:Bounds x="882" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="863" y="268" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="882" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="871" y="158" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="730" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cancel_di" bpmnElement="Task_Cancel">
        <dc:Bounds x="730" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="190" />
        <di:waypoint x="320" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="230" />
        <di:waypoint x="370" y="390" />
        <di:waypoint x="460" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="560" y="390" />
        <di:waypoint x="630" y="390" />
        <di:waypoint x="630" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="630" y="165" />
        <di:waypoint x="630" y="140" />
        <di:waypoint x="730" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="122" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="630" y="215" />
        <di:waypoint x="630" y="250" />
        <di:waypoint x="730" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="663" y="253" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End1_di" bpmnElement="Flow_End1">
        <di:waypoint x="830" y="140" />
        <di:waypoint x="882" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End2_di" bpmnElement="Flow_End2">
        <di:waypoint x="830" y="250" />
        <di:waypoint x="882" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
